@code {
    private List<CatalogueProduitDto>? produits;
    private List<MaCommandeDto>? mesCommandes;
    private string searchString = "";
    private string categoryFilter = "";
    private bool showCommandes = false;

    // Dialog commande
    private CatalogueProduitDto? produitSelectionne;
    private int commandeQuantite = 1;
    private decimal commandePrix = 0;
    private bool commandeEnCours = false;

    // Dialog annulation
    private MaCommandeDto? commandeAnnuler;
    private bool annulationEnCours = false;

    // Palette couleurs catégories (cohérente avec la page produits)
    private static readonly string[] SwatchPalette = new[]
    {
        "#2B4C7E", "#B5563A", "#B8842C", "#4A6FA5", "#7C4A6E"
    };

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(ChargerCatalogue(), ChargerMesCommandes());
    }

    private async Task ChargerCatalogue()
    {
        try { produits = await CatalogueService.ObtenirCatalogue(); }
        catch { produits = new List<CatalogueProduitDto>(); }
    }

    private async Task ChargerMesCommandes()
    {
        try { mesCommandes = await CatalogueService.ObtenirMesCommandes(); }
        catch { mesCommandes = new List<MaCommandeDto>(); }
    }

    private static readonly List<string> CategoriesParDefaut = new()
    {
        "Jacket", "Pants", "Set", "Shirt", "Shorts", "Dress", "Coat", "Skirt"
    };

    private IEnumerable<string> CategoriesDisponibles
    {
        get
        {
            var list = new List<string>(CategoriesParDefaut);
            if (produits != null)
            {
                foreach (var cat in produits.Select(p => p.Categorie).Where(c => !string.IsNullOrWhiteSpace(c)))
                {
                    if (!list.Contains(cat, StringComparer.OrdinalIgnoreCase))
                    {
                        list.Add(cat!);
                    }
                }
            }
            return list.Distinct().OrderBy(c => c);
        }
    }

    private IEnumerable<CatalogueProduitDto> FilteredProduits => produits == null
        ? Enumerable.Empty<CatalogueProduitDto>()
        : produits.Where(p => FilterFunc(p));

    private bool FilterFunc(CatalogueProduitDto p)
    {
        if (!string.IsNullOrEmpty(categoryFilter) && !string.Equals(p.Categorie, categoryFilter, StringComparison.OrdinalIgnoreCase))
            return false;

        if (string.IsNullOrWhiteSpace(searchString)) return true;

        if (p.Nom?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        if (p.Reference?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        if (p.TypeTissu?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        if (p.Categorie?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;

        return false;
    }

    private string GetCategoryColor(string? categorie)
    {
        if (string.IsNullOrWhiteSpace(categorie)) return "#64748B";
        int hash = 0;
        foreach (var c in categorie) hash = (hash * 31 + c) & 0x7FFFFFFF;
        return SwatchPalette[hash % SwatchPalette.Length];
    }

    private string GetFullImageUrl(string? relativeUrl)
    {
        if (string.IsNullOrEmpty(relativeUrl)) return "";
        return $"{Http.BaseAddress}{relativeUrl.TrimStart('/')}";
    }

    private CatalogueProduitDto? produitDetailsModal;

    private void OuvrirDetails(CatalogueProduitDto produit) => produitDetailsModal = produit;
    private void FermerDetails() => produitDetailsModal = null;

    private void OuvrirCommande(CatalogueProduitDto produit)
    {
        produitSelectionne = produit;
        commandeQuantite = 1;
        commandePrix = produit.PrixUnitaire;
    }

    private void FermerCommande() => produitSelectionne = null;

    private async Task ConfirmerCommande()
    {
        if (produitSelectionne == null || commandeQuantite <= 0 || commandePrix <= 0)
        {
            Snackbar.Add("Veuillez remplir tous les champs correctement.", Severity.Warning);
            return;
        }

        commandeEnCours = true;
        var dto = new CommandeCreateDto
        {
            ProduitId = produitSelectionne.Id,
            QuantiteVendue = commandeQuantite,
            PrixUnitaire = commandePrix
        };

        var succes = await CatalogueService.PasserCommande(dto);
        commandeEnCours = false;

        if (succes)
        {
            Snackbar.Add($"Commande de {commandeQuantite} article(s) de « {produitSelectionne.Nom} » confirmée !", Severity.Success);
            FermerCommande();
            await ChargerMesCommandes();
        }
        else
        {
            Snackbar.Add("Erreur lors de la commande. Veuillez réessayer.", Severity.Error);
        }
    }

    private string GetStatutCssClass(string? statut) => statut switch
    {
        "ACCEPTEE" => "statut-acceptee",
        "EN_ATTENTE" => "statut-attente",
        "REFUSEE" => "statut-refusee",
        _ => "statut-attente"
    };

    private string GetStatutLabel(string? statut) => statut switch
    {
        "ACCEPTEE" => "Acceptée",
        "EN_ATTENTE" => "En attente",
        "REFUSEE" => "Refusée",
        _ => statut ?? "En attente"
    };

    // ===== Annulation de commande =====
    private void DemanderAnnulation(MaCommandeDto commande)
    {
        commandeAnnuler = commande;
    }

    private void FermerAnnulation() => commandeAnnuler = null;

    private async Task ConfirmerAnnulation()
    {
        if (commandeAnnuler == null) return;

        annulationEnCours = true;
        var succes = await CatalogueService.AnnulerCommande(commandeAnnuler.Id);
        annulationEnCours = false;

        if (succes)
        {
            Snackbar.Add($"Commande de « {commandeAnnuler.ProduitNom} » annulée avec succès.", Severity.Success);
            FermerAnnulation();
            await ChargerMesCommandes();
        }
        else
        {
            Snackbar.Add("Impossible d'annuler cette commande. Veuillez réessayer.", Severity.Error);
        }
    }
}
