@code {
    private List<ProduitDto>? produits;
    private List<CommandeManagerDto>? commandesClients;
    private string searchString = "";
    private string categoryFilter = "";
    private string statutIaFilter = ""; // "", "RUPTURE", "SURSTOCK", "OPTIMAL"
    private string sortBy = "STATUT_IA"; // "STATUT_IA", "NOM", "STOCK_ASC", "STOCK_DESC"
    private bool isGridView = true;

    // Palette "échantillon tissu"
    private static readonly string[] SwatchPalette = new[]
    {
        "#2B4C7E", // denim
        "#B5563A", // clay
        "#B8842C", // ochre
        "#4A6FA5", // steel blue
        "#7C4A6E"  // plum
    };

    protected override async Task OnInitializedAsync()
    {
        await ChargerDonnees();
    }

    private async Task ChargerDonnees()
    {
        try
        {
            produits = await ProduitService.ObtenirTous();
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login", forceLoad: false);
            return;
        }
        catch
        {
            produits = new List<ProduitDto>();
        }

        try
        {
            commandesClients = await CatalogueService.ObtenirToutesLesCommandes();
        }
        catch
        {
            commandesClients = new List<CommandeManagerDto>();
        }
    }

    private static readonly List<string> CategoriesParDefaut = new()
    {
        "Jacket", "Pants", "Set", "Shirt", "Shorts", "Dress", "Coat", "Skirt"
    };

    private IEnumerable<string> CategoriesDisponibles
    {
        get
        {
            var list = new List<string>(CategoriesParDefaut);
            if (produits != null)
            {
                foreach (var cat in produits.Select(p => p.Categorie).Where(c => !string.IsNullOrWhiteSpace(c)))
                {
                    if (!list.Contains(cat, StringComparer.OrdinalIgnoreCase))
                    {
                        list.Add(cat!);
                    }
                }
            }
            return list.Distinct().OrderBy(c => c);
        }
    }

    private IEnumerable<ProduitDto> FilteredProduits
    {
        get
        {
            if (produits == null) return Enumerable.Empty<ProduitDto>();

            var list = produits.Where(p => FilterFunc(p));

            if (!string.IsNullOrEmpty(statutIaFilter))
            {
                list = list.Where(p => string.Equals(p.StatutIAType, statutIaFilter, StringComparison.OrdinalIgnoreCase));
            }

            return sortBy switch
            {
                "STATUT_IA" => list.OrderBy(p => p.StatutIAPriorite).ThenBy(p => p.Stock?.QuantiteActuelle ?? 0),
                "NOM" => list.OrderBy(p => p.Nom),
                "STOCK_ASC" => list.OrderBy(p => p.Stock?.QuantiteActuelle ?? 0),
                "STOCK_DESC" => list.OrderByDescending(p => p.Stock?.QuantiteActuelle ?? 0),
                _ => list.OrderBy(p => p.StatutIAPriorite)
            };
        }
    }

    private bool FilterFunc(ProduitDto p)
    {
        if (!string.IsNullOrEmpty(categoryFilter) && !string.Equals(p.Categorie, categoryFilter, StringComparison.OrdinalIgnoreCase))
            return false;

        if (string.IsNullOrWhiteSpace(searchString))
            return true;

        if (p.Nom?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        if (p.Reference?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        if (p.TypeTissu?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        if (p.Categorie?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        if (p.StatutIABadgeText?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;

        return false;
    }

    private string GetStatutIaFilterLabel() => statutIaFilter switch
    {
        "RUPTURE" => "🔴 Ruptures",
        "SURSTOCK" => "🟠 Surstock",
        "OPTIMAL" => "🟢 Stock optimal",
        _ => "Tous les statuts IA"
    };

    private string GetSortLabel() => sortBy switch
    {
        "STATUT_IA" => "Statut IA (Priorité)",
        "NOM" => "Nom (A-Z)",
        "STOCK_ASC" => "Stock (▲)",
        "STOCK_DESC" => "Stock (▼)",
        _ => "Trier par"
    };

    private string GetCategoryColor(string? categorie)
    {
        if (string.IsNullOrWhiteSpace(categorie))
            return "#64748B";

        int hash = 0;
        foreach (var c in categorie) hash = (hash * 31 + c) & 0x7FFFFFFF;
        return SwatchPalette[hash % SwatchPalette.Length];
    }

    private void AllerVersCreation() => Navigation.NavigateTo("/produits/creer");

    private async Task Supprimer(int id)
    {
        var succes = await ProduitService.Supprimer(id);
        if (succes)
        {
            produits = await ProduitService.ObtenirTous();
        }
    }

    private string GetFullImageUrl(string? relativeUrl)
    {
        if (string.IsNullOrEmpty(relativeUrl)) return "";
        return $"{Http.BaseAddress}{relativeUrl.TrimStart('/')}";
    }

    // ===== GESTION DE COMMANDES CLIENTS =====
    private int NombreCommandesEnAttente => commandesClients == null
        ? 0
        : commandesClients.Count(c => c.StatutCommande == "EN_ATTENTE");
}
