@page "/admin/dashboard"
@attribute [Authorize(Roles = "ADMIN")]
@inject DashboardService DashboardService
@inject NavigationManager Navigation

<PageTitle>Tableau de bord Admin | WicStock</PageTitle>

<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
</HeadContent>

<div class="dashboard-page pa-4 pa-md-6">
    <div class="d-flex justify-space-between align-center mb-6 flex-wrap gap-4">
        <div>
            <h1 class="dashboard-title">Tableau de bord Administration</h1>
            <p class="dashboard-subtitle">Vue d'ensemble de l'activité, du stock et des ventes</p>
        </div>
        <button class="btn btn--outline" @onclick="ChargerDonnees">
            <MudIcon Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" />
            <span>Actualiser</span>
        </button>
    </div>

    @if (data == null)
    {
        <div class="d-flex justify-center my-12">
            <MudProgressCircular Indeterminate="true" Style="color: var(--denim);" Size="Size.Large" />
        </div>
    }
    else
    {
        @if (data.ProduitsEnRupture > 0)
        {
            <div class="alert-rupture mb-6">
                <MudIcon Icon="@Icons.Material.Filled.WarningAmber" />
                <span><strong>Attention :</strong> @data.ProduitsEnRupture produit(s) en rupture de stock totale ! Consultez l'inventaire pour le réapprovisionnement.</span>
            </div>
        }

        <!-- ===== KPI CARDS ===== -->
        <MudGrid Class="mb-6">
            <MudItem xs="12" sm="6" md="3">
                <div class="kpi-card">
                    <div class="kpi-icon kpi-icon--denim">
                        <MudIcon Icon="@Icons.Material.Filled.Inventory2" />
                    </div>
                    <div class="kpi-content">
                        <span class="kpi-label">Total Produits</span>
                        <h2 class="kpi-value">@data.TotalProduits</h2>
                        <span class="kpi-sub">Articles enregistrés</span>
                    </div>
                </div>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <div class="kpi-card">
                    <div class="kpi-icon kpi-icon--pine">
                        <MudIcon Icon="@Icons.Material.Filled.AttachMoney" />
                    </div>
                    <div class="kpi-content">
                        <span class="kpi-label">Chiffre d'Affaires</span>
                        <h2 class="kpi-value">@data.RevenuTotal.ToString("N2") DT</h2>
                        <span class="kpi-sub">@data.TotalProduitsVendus articles vendus</span>
                    </div>
                </div>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <div class="kpi-card">
                    <div class="kpi-icon kpi-icon--plum">
                        <MudIcon Icon="@Icons.Material.Filled.People" />
                    </div>
                    <div class="kpi-content">
                        <span class="kpi-label">Utilisateurs</span>
                        <h2 class="kpi-value">@data.TotalUtilisateurs</h2>
                        <span class="kpi-sub">Comptes enregistrés</span>
                    </div>
                </div>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <div class="kpi-card">
                    <div class="kpi-icon kpi-icon--ochre">
                        <MudIcon Icon="@Icons.Material.Filled.ShoppingBag" />
                    </div>
                    <div class="kpi-content">
                        <span class="kpi-label">Commandes</span>
                        <h2 class="kpi-value">@data.TotalCommandes</h2>
                        <span class="kpi-sub">Toutes demandes confondues</span>
                    </div>
                </div>
            </MudItem>
        </MudGrid>

        <!-- ===== GRAPHIQUES & REPARTITIONS ===== -->
        <MudGrid Class="mb-6">
            <!-- Graphique Revenus (Bar Chart Moderne) -->
            <MudItem xs="12" lg="8">
                <div class="chart-card">
                    <div class="chart-header d-flex justify-space-between align-center">
                        <div>
                            <h3 class="chart-title">Évolution des Revenus Mensuels (DT)</h3>
                            <span class="chart-subtitle">Revenus générés sur les 6 derniers mois</span>
                        </div>
                        <div class="chart-badge">
                            <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Small" />
                            <span>@data.RevenuTotal.ToString("N0") DT Total</span>
                        </div>
                    </div>

                    <div class="chart-body">
                        @if (data.EvolutionRevenus != null && data.EvolutionRevenus.Any())
                        {
                            var maxRevenu = Math.Max(100m, data.EvolutionRevenus.Max(r => r.Montant));
                            
                            <div class="bar-chart-container">
                                <div class="bar-chart-grid">
                                    <div class="grid-line" style="bottom: 100%;"><span>@maxRevenu.ToString("N0") DT</span></div>
                                    <div class="grid-line" style="bottom: 75%;"><span>@((maxRevenu * 0.75m).ToString("N0")) DT</span></div>
                                    <div class="grid-line" style="bottom: 50%;"><span>@((maxRevenu * 0.5m).ToString("N0")) DT</span></div>
                                    <div class="grid-line" style="bottom: 25%;"><span>@((maxRevenu * 0.25m).ToString("N0")) DT</span></div>
                                    <div class="grid-line" style="bottom: 0%;"><span>0 DT</span></div>
                                </div>

                                <div class="bar-chart-bars">
                                    @foreach (var item in data.EvolutionRevenus)
                                    {
                                        var heightPct = (double)(item.Montant / maxRevenu * 100m);
                                        if (heightPct < 3 && item.Montant > 0) heightPct = 3;

                                        <div class="bar-column">
                                            <div class="bar-wrapper">
                                                @if (item.Montant > 0)
                                                {
                                                    <span class="bar-tooltip">@item.Montant.ToString("N0") DT</span>
                                                }
                                                <div class="bar-fill @(item.Montant > 0 ? "active" : "empty")" style="height: @(heightPct.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture))%;"></div>
                                            </div>
                                            <span class="bar-label">@item.Mois</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="empty-chart">
                                <MudIcon Icon="@Icons.Material.Filled.ShowChart" Style="font-size: 2rem; opacity: 0.35;" />
                                <span>Aucune donnée d'historique de vente disponible.</span>
                            </div>
                        }
                    </div>
                </div>
            </MudItem>

            <!-- Répartition des Statuts de Commandes (Progression & Ring Moderne) -->
            <MudItem xs="12" lg="4">
                <div class="chart-card h-100 d-flex flex-column">
                    <div class="chart-header">
                        <h3 class="chart-title">Statut des Commandes</h3>
                        <span class="chart-subtitle">Répartition globale selon l'état</span>
                    </div>

                    <div class="chart-body flex-1 d-flex flex-column justify-center">
                        @if (data.TotalCommandes > 0)
                        {
                            var total = (double)data.TotalCommandes;
                            var accepteesPct = Math.Round((data.StatutCommandes.Acceptees / total) * 100);
                            var enAttentePct = Math.Round((data.StatutCommandes.EnAttente / total) * 100);
                            var refuseesPct = Math.Round((data.StatutCommandes.Refusees / total) * 100);

                            <!-- Donut Ring SVG Ultra Moderne -->
                            <div class="donut-wrapper mb-4">
                                <svg viewBox="0 0 36 36" class="donut-svg">
                                    <path class="donut-ring" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                                    
                                    @if (data.StatutCommandes.Acceptees > 0)
                                    {
                                        <path class="donut-segment segment-green"
                                              stroke-dasharray="@(accepteesPct.ToString(System.Globalization.CultureInfo.InvariantCulture)), 100"
                                              stroke-dashoffset="0"
                                              d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                                    }
                                    @if (data.StatutCommandes.EnAttente > 0)
                                    {
                                        <path class="donut-segment segment-ochre"
                                              stroke-dasharray="@(enAttentePct.ToString(System.Globalization.CultureInfo.InvariantCulture)), 100"
                                              stroke-dashoffset="@((-accepteesPct).ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                              d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                                    }
                                    @if (data.StatutCommandes.Refusees > 0)
                                    {
                                        <path class="donut-segment segment-rust"
                                              stroke-dasharray="@(refuseesPct.ToString(System.Globalization.CultureInfo.InvariantCulture)), 100"
                                              stroke-dashoffset="@((-(accepteesPct + enAttentePct)).ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                              d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                                    }
                                </svg>
                                <div class="donut-center">
                                    <span class="donut-number">@data.TotalCommandes</span>
                                    <span class="donut-label">Commandes</span>
                                </div>
                            </div>

                            <!-- Barres de Progression des Statuts -->
                            <div class="status-list">
                                <div class="status-item mb-3">
                                    <div class="d-flex justify-space-between align-center mb-1">
                                        <span class="status-label d-flex align-center gap-2">
                                            <span class="dot dot-green"></span>
                                            Validées / Acceptées
                                        </span>
                                        <span class="status-count">@data.StatutCommandes.Acceptees (@accepteesPct%)</span>
                                    </div>
                                    <div class="progress-bar-bg">
                                        <div class="progress-bar-fill fill-green" style="width: @(accepteesPct)%;"></div>
                                    </div>
                                </div>

                                <div class="status-item mb-3">
                                    <div class="d-flex justify-space-between align-center mb-1">
                                        <span class="status-label d-flex align-center gap-2">
                                            <span class="dot dot-ochre"></span>
                                            En attente de validation
                                        </span>
                                        <span class="status-count">@data.StatutCommandes.EnAttente (@enAttentePct%)</span>
                                    </div>
                                    <div class="progress-bar-bg">
                                        <div class="progress-bar-fill fill-ochre" style="width: @(enAttentePct)%;"></div>
                                    </div>
                                </div>

                                <div class="status-item">
                                    <div class="d-flex justify-space-between align-center mb-1">
                                        <span class="status-label d-flex align-center gap-2">
                                            <span class="dot dot-rust"></span>
                                            Refusées
                                        </span>
                                        <span class="status-count">@data.StatutCommandes.Refusees (@refuseesPct%)</span>
                                    </div>
                                    <div class="progress-bar-bg">
                                        <div class="progress-bar-fill fill-rust" style="width: @(refuseesPct)%;"></div>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="empty-chart">
                                <MudIcon Icon="@Icons.Material.Filled.Inbox" Style="font-size: 2rem; opacity: 0.35;" />
                                <span>Aucune commande enregistrée.</span>
                            </div>
                        }
                    </div>
                </div>
            </MudItem>
        </MudGrid>

        <!-- ===== TOP PRODUITS VENDUS ET SURSTOCKS ===== -->
        <MudGrid>
            <!-- Top Produits Vendus -->
            <MudItem xs="12" md="6">
                <div class="table-card h-100 d-flex flex-column">
                    <div class="chart-header d-flex justify-space-between align-center">
                        <div>
                            <h3 class="chart-title">Top 5 des Ventes</h3>
                            <span class="chart-subtitle">Volume de commandes le plus fort</span>
                        </div>
                    </div>
                    <div class="table-responsive flex-1">
                        <table class="manager-orders-table" style="width: 100%;">
                            <thead>
                                <tr>
                                    <th>Nom</th>
                                    <th>Qte Vendue</th>
                                    <th>Total (DT)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (data.TopProduitsVendus != null && data.TopProduitsVendus.Any())
                                {
                                    @foreach (var prod in data.TopProduitsVendus)
                                    {
                                        <tr>
                                            <td class="font-weight-bold" style="color: var(--ink);">@prod.Nom</td>
                                            <td>
                                                <span class="badge-statut statut-acceptee">
                                                    @prod.QuantiteVendue
                                                </span>
                                            </td>
                                            <td class="font-weight-bold" style="color: var(--denim); font-family: var(--font-display);">
                                                @prod.TotalVentes.ToString("N2")
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="3" class="text-center text-muted pa-6">Aucune vente enregistrée.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </MudItem>

            <!-- Produits en Surstock -->
            <MudItem xs="12" md="6">
                <div class="table-card h-100 d-flex flex-column">
                    <div class="chart-header d-flex justify-space-between align-center">
                        <div>
                            <h3 class="chart-title" style="color: var(--ochre);">Alertes de Surstock (Top 5)</h3>
                            <span class="chart-subtitle">Produits avec un excédent de stock</span>
                        </div>
                    </div>
                    <div class="table-responsive flex-1">
                        <table class="manager-orders-table" style="width: 100%;">
                            <thead>
                                <tr>
                                    <th>Référence</th>
                                    <th>Nom</th>
                                    <th>Stock</th>
                                    <th>Excédent</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (data.ProduitsEnSurstock != null && data.ProduitsEnSurstock.Any())
                                {
                                    @foreach (var prod in data.ProduitsEnSurstock)
                                    {
                                        <tr>
                                            <td><span class="ref-code">@prod.Reference</span></td>
                                            <td class="font-weight-bold" style="color: var(--ink);">@prod.Nom</td>
                                            <td>@prod.QuantiteActuelle</td>
                                            <td>
                                                <span class="badge-statut" style="background: var(--ochre-tint); color: var(--ochre);">
                                                    +@prod.PourcentageSurstock
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center text-muted pa-6">Aucun produit en surstock détecté.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </MudItem>
        </MudGrid>
    }
</div>

<style>
    .dashboard-page {
        --ink: #16233A;
        --ink-muted: #64748B;
        --paper: #FFFFFF;
        --sand: #F3F6FA;
        --border: #E1E7EF;
        --denim: #2B4C7E;
        --denim-dark: #14263F;
        --denim-tint: #E7EDF6;
        --pine: #1E8E3E;
        --pine-tint: #E6F4EA;
        --ochre: #D97706;
        --ochre-tint: #FEF3C7;
        --plum: #9333EA;
        --plum-tint: #F3E8FD;
        --rust: #DC2626;
        --rust-tint: #FEE2E2;
        --font-display: "Sora", "Inter", sans-serif;
        --font-body: "Inter", sans-serif;
        font-family: var(--font-body);
        color: var(--ink);
    }

    .dashboard-title {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 1.5rem;
        color: var(--ink);
        margin: 0;
    }

    .dashboard-subtitle {
        font-size: 0.875rem;
        color: var(--ink-muted);
        margin: 4px 0 0 0;
    }

    /* ===== Buttons & Badges ===== */
    .btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 16px;
        border-radius: 8px;
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.15s ease;
        text-decoration: none;
    }

    .btn--outline {
        border: 1px solid var(--border);
        background: var(--paper);
        color: var(--ink);
    }

    .btn--outline:hover {
        background: var(--sand);
        border-color: var(--denim);
    }

    .alert-rupture {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 16px;
        background: var(--rust-tint);
        border: 1px solid #FCA5A5;
        border-radius: 10px;
        color: var(--rust);
        font-size: 0.875rem;
    }

    /* ===== KPI Cards ===== */
    .kpi-card {
        background: var(--paper);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 16px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.03);
        transition: transform 0.15s ease;
    }

    .kpi-card:hover {
        transform: translateY(-2px);
    }

    .kpi-icon {
        width: 48px;
        height: 48px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 1.25rem;
    }

    .kpi-icon--denim { background: var(--denim-tint); color: var(--denim); }
    .kpi-icon--pine { background: var(--pine-tint); color: var(--pine); }
    .kpi-icon--plum { background: var(--plum-tint); color: var(--plum); }
    .kpi-icon--ochre { background: var(--ochre-tint); color: var(--ochre); }

    .kpi-label {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--ink-muted);
    }

    .kpi-value {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 1.35rem;
        color: var(--ink);
        margin: 2px 0;
    }

    .kpi-sub {
        font-size: 0.75rem;
        color: var(--ink-muted);
    }

    /* ===== Chart Card ===== */
    .chart-card, .table-card {
        background: var(--paper);
        border: 1px solid var(--border);
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0,0,0,0.03);
    }

    .chart-header {
        padding: 16px 20px;
        border-bottom: 1px solid var(--border);
        background: var(--sand);
    }

    .chart-title {
        font-family: var(--font-display);
        font-size: 1rem;
        font-weight: 700;
        color: var(--ink);
        margin: 0;
    }

    .chart-subtitle {
        font-size: 0.75rem;
        color: var(--ink-muted);
    }

    .chart-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 10px;
        background: var(--denim-tint);
        color: var(--denim);
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 700;
    }

    .chart-body {
        padding: 24px;
    }

    .empty-chart {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 40px;
        color: var(--ink-muted);
        font-size: 0.875rem;
    }

    /* ===== Custom Modern Bar Chart ===== */
    .bar-chart-container {
        position: relative;
        height: 240px;
        padding-left: 65px;
        padding-bottom: 30px;
    }

    .bar-chart-grid {
        position: absolute;
        top: 0;
        left: 65px;
        right: 0;
        bottom: 30px;
    }

    .grid-line {
        position: absolute;
        left: 0;
        right: 0;
        border-bottom: 1px dashed var(--border);
    }

    .grid-line span {
        position: absolute;
        left: -65px;
        bottom: -6px;
        font-size: 0.7rem;
        color: var(--ink-muted);
        font-weight: 500;
        text-align: right;
        width: 55px;
    }

    .bar-chart-bars {
        position: relative;
        height: 100%;
        display: flex;
        align-items: flex-end;
        justify-content: space-around;
        gap: 12px;
        z-index: 2;
    }

    .bar-column {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        height: 100%;
    }

    .bar-wrapper {
        position: relative;
        width: 100%;
        max-width: 42px;
        height: 100%;
        display: flex;
        align-items: flex-end;
        justify-content: center;
    }

    .bar-fill {
        width: 100%;
        border-radius: 6px 6px 0 0;
        transition: height 0.4s ease, background 0.2s ease;
    }

    .bar-fill.active {
        background: linear-gradient(180deg, var(--denim) 0%, var(--denim-dark) 100%);
    }

    .bar-fill.empty {
        background: var(--sand);
        height: 4px !important;
        border-radius: 2px;
    }

    .bar-wrapper:hover .bar-fill.active {
        background: var(--denim);
        box-shadow: 0 0 10px rgba(43,76,126,0.3);
    }

    .bar-tooltip {
        position: absolute;
        top: -26px;
        background: var(--ink);
        color: #fff;
        font-size: 0.7rem;
        font-weight: 600;
        padding: 2px 6px;
        border-radius: 4px;
        white-space: nowrap;
        opacity: 0.9;
    }

    .bar-label {
        margin-top: 8px;
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--ink-muted);
    }

    /* ===== Custom Modern Donut Chart & Progress Bars ===== */
    .donut-wrapper {
        position: relative;
        width: 140px;
        height: 140px;
        margin: 0 auto;
    }

    .donut-svg {
        width: 100%;
        height: 100%;
        transform: rotate(-90deg);
        border-radius: 50%;
    }

    .donut-ring {
        fill: none;
        stroke: var(--sand);
        stroke-width: 3.8;
    }

    .donut-segment {
        fill: none;
        stroke-width: 3.8;
        transition: stroke-dasharray 0.3s ease;
    }

    .segment-green { stroke: var(--pine); }
    .segment-ochre { stroke: var(--ochre); }
    .segment-rust { stroke: var(--rust); }

    .donut-center {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .donut-number {
        font-family: var(--font-display);
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--ink);
        line-height: 1;
    }

    .donut-label {
        font-size: 0.7rem;
        color: var(--ink-muted);
        font-weight: 500;
        margin-top: 2px;
    }

    .status-list {
        width: 100%;
    }

    .status-label {
        font-size: 0.8rem;
        font-weight: 500;
        color: var(--ink);
    }

    .status-count {
        font-size: 0.8rem;
        font-weight: 700;
        color: var(--ink);
    }

    .dot {
