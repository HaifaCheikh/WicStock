@page "/utilisateurs"
@using WicStock.Web.Models.Dtos
@using WicStock.Web.Services
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "ADMIN")]
@inject UtilisateurService UtilisateurService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
</HeadContent>

<div class="utilisateurs-page">
    <MudStack Spacing="6">
        <!-- En-tête principal -->
        <div class="d-flex justify-space-between align-center flex-wrap gap-4">
            <div>
                <div class="d-flex align-center gap-3">
                    <MudText Typo="Typo.h4" Class="page-title">Gestion des utilisateurs</MudText>
                    @if (utilisateurs != null)
                    {
                        <span class="count-badge">@FilteredUtilisateurs.Count() comptes</span>
                    }
                </div>
                <MudText Typo="Typo.body2" Class="page-subtitle mt-1">
                    Gérez les accès, rôles et comptes des utilisateurs de la plateforme WicStock
                </MudText>
            </div>

            <div class="d-flex align-center gap-3">
                <!-- Basculeur Grille / Tableau -->
                <div class="view-toggle">
                    <button class="view-toggle-btn @(isGridView ? "active" : "")" @onclick="() => isGridView = true" aria-label="Vue grille">
                        <MudIcon Icon="@Icons.Material.Filled.GridView" Size="Size.Small" />
                    </button>
                    <button class="view-toggle-btn @(!isGridView ? "active" : "")" @onclick="() => isGridView = false" aria-label="Vue tableau">
                        <MudIcon Icon="@Icons.Material.Filled.FormatListBulleted" Size="Size.Small" />
                    </button>
                </div>

                <button class="btn btn--primary" @onclick="AllerVersInscription">
                    <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Size="Size.Small" />
                    <span>Nouvel utilisateur</span>
                </button>
            </div>
        </div>

        <!-- Barre de recherche et filtres par rôle -->
        <div class="filter-panel">
            <div class="d-flex flex-column flex-md-row justify-space-between align-center gap-4">
                <div style="flex: 1; width: 100%;">
                    <MudTextField @bind-Value="searchString"
                                  Placeholder="Rechercher par nom, prénom, email ou rôle..."
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  IconSize="Size.Medium"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Clearable="true"
                                  Immediate="true"
                                  Class="search-field" />
                </div>

                <!-- Menu déroulant Filtrer par rôle -->
                <MudMenu EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
                         StartIcon="@Icons.Material.Filled.FilterList"
                         Label="@(string.IsNullOrEmpty(roleFilter) ? "Tous les rôles" : GetRoleLabel(roleFilter))"
                         Variant="Variant.Outlined"
                         Color="@(string.IsNullOrEmpty(roleFilter) ? Color.Default : Color.Primary)"
                         Style="border-radius: 10px; font-weight: 600; text-transform: none; height: 40px;"
                         AnchorOrigin="Origin.BottomRight"
                         TransformOrigin="Origin.TopRight">
                    <MudMenuItem OnClick='() => roleFilter = ""'>
                        <div class="d-flex align-center gap-2">
                            <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Small" Style="color: #2B4C7E;" />
                            <span style="@(string.IsNullOrEmpty(roleFilter) ? "font-weight:700; color:#2B4C7E;" : "font-weight:500;")">Tous les rôles</span>
                        </div>
                    </MudMenuItem>
                    <MudDivider />
                    @foreach (var role in new[] { "ADMIN", "RESPONSABLE_STOCK_PRODUCTION", "CLIENT" })
                    {
                        var isSelected = roleFilter == role;
                        <MudMenuItem OnClick="() => roleFilter = role">
                            <div class="d-flex align-center gap-2">
                                <span style="width: 8px; height: 8px; border-radius: 50%; display: inline-block; background-color: @GetRoleColor(role);"></span>
                                <span style="@(isSelected ? "font-weight:700; color:#2B4C7E;" : "font-weight:500;")">@GetRoleLabel(role)</span>
                            </div>
                        </MudMenuItem>
                    }
                </MudMenu>
            </div>
        </div>

        <!-- Corps de la page -->
        @if (utilisateurs == null)
        {
            <!-- Skeleton chargement -->
            <MudGrid Spacing="3">
                @for (int i = 0; i < 6; i++)
                {
                    <MudItem xs="12" sm="6" md="4">
                        <div class="skeleton-card">
                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="72px" />
                            <div class="pa-4 d-flex flex-column gap-2">
                                <MudSkeleton Width="60%" Height="20px" />
                                <MudSkeleton Width="40%" Height="16px" />
                                <MudSkeleton Width="80%" Height="16px" Class="mt-2" />
                            </div>
                        </div>
                    </MudItem>
                }
            </MudGrid>
        }
        else if (!FilteredUtilisateurs.Any())
        {
            <div class="empty-state">
                <div class="empty-icon">
                    <MudIcon Icon="@Icons.Material.Filled.PeopleOutline" Size="Size.Large" />
                </div>
                <MudText Typo="Typo.h6" Class="empty-title mt-3">Aucun utilisateur trouvé</MudText>
                <MudText Typo="Typo.body2" Class="empty-subtitle mt-1">Modifiez vos filtres ou créez un nouvel utilisateur.</MudText>
            </div>
        }
        else if (isGridView)
        {
            <!-- ===== VUE GRILLE ===== -->
            <MudGrid Spacing="3">
                @foreach (var user in FilteredUtilisateurs)
                {
                    var roleColor = GetRoleColor(user.Role);
                    <MudItem xs="12" sm="6" md="4">
                        <div class="user-card">
                            <!-- Bande couleur de rôle -->
                            <div class="swatch-strip" style="background: @roleColor;"></div>

                            <!-- Zone image / avatar -->
                            <div class="user-avatar-zone">
                                <div class="user-avatar" style="background: @roleColor;">
                                    @GetInitials(user.Prenom, user.Nom)
                                </div>
                                <div class="badge-role" style="background: @roleColor;">
                                    @GetRoleLabel(user.Role)
                                </div>
                            </div>

                            <!-- Corps de la carte -->
                            <div class="user-body">
                                <div>
                                    <div class="user-name">@user.Prenom @user.Nom</div>
                                </div>

                                <!-- Contact -->
                                <div class="contact-block">
                                    <div class="contact-row">
                                        <MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Small" Class="contact-icon" />
                                        <span class="contact-value">@user.Email</span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(user.Telephone))
                                    {
                                        <div class="contact-row">
                                            <MudIcon Icon="@Icons.Material.Filled.Phone" Size="Size.Small" Class="contact-icon" />
                                            <span class="contact-value">@user.Telephone</span>
                                        </div>
                                    }
                                </div>

                                <!-- Pied de carte : rôle + action -->
                                <div class="user-footer">
                                    <div class="role-select-wrap">
                                        <MudSelect T="string"
                                                   Value="@user.Role"
                                                   ValueChanged="@(async (newRole) => await ModifierRoleUser(user, newRole))"
                                                   Label="Rôle"
                                                   Variant="Variant.Outlined"
                                                   Margin="Margin.Dense"
                                                   Style="font-size: 0.85rem; font-weight: 600;" >
                                            <MudSelectItem Value="@("ADMIN")">Admin</MudSelectItem>
                                            <MudSelectItem Value="@("RESPONSABLE_STOCK_PRODUCTION")">Resp. Stock & Production</MudSelectItem>
                                            <MudSelectItem Value="@("CLIENT")">Client</MudSelectItem>
                                        </MudSelect>
                                    </div>
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Size="Size.Small"
                                                   Class="action-btn action-btn--danger"
                                                   OnClick="() => SupprimerUser(user.Id)" />
                                </div>
                            </div>
                        </div>
                    </MudItem>
                }
            </MudGrid>
        }
        else
        {
            <!-- ===== VUE TABLEAU ===== -->
            <div class="table-panel">
                <MudTable Items="@FilteredUtilisateurs"
                          Hover="true"
                          Elevation="0"
                          Class="users-table">
                    <HeaderContent>
                        <MudTh></MudTh>
                        <MudTh>Nom & Prénom</MudTh>
                        <MudTh>Email</MudTh>
                        <MudTh>Téléphone</MudTh>
                        <MudTh>Rôle</MudTh>
                        <MudTh Style="text-align: right;">Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Avatar">
                            <div class="table-avatar" style="background: @GetRoleColor(context.Role);">
                                @GetInitials(context.Prenom, context.Nom)
                            </div>
                        </MudTd>
                        <MudTd DataLabel="Nom" Class="cell-name">@context.Prenom @context.Nom</MudTd>
                        <MudTd DataLabel="Email">@context.Email</MudTd>
                        <MudTd DataLabel="Téléphone">@(string.IsNullOrEmpty(context.Telephone) ? "—" : context.Telephone)</MudTd>
                        <MudTd DataLabel="Rôle">
                            <span class="table-role-tag" style="background: @GetRoleColor(context.Role);">
                                @GetRoleLabel(context.Role)
                            </span>
                        </MudTd>
                        <MudTd Style="text-align: right;">
                            <div class="d-flex justify-end gap-1">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Size="Size.Small"
                                               Class="action-btn action-btn--danger"
                                               OnClick="() => SupprimerUser(context.Id)" />
                            </div>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </div>
        }
    </MudStack>
</div>

<style>
    .utilisateurs-page {
        --ink: #16233A;
        --ink-muted: #64748B;
        --paper: #FFFFFF;
        --sand: #F3F6FA;
        --border: #E1E7EF;
        --denim: #2B4C7E;
        --denim-dark: #14263F;
        --denim-tint: #E7EDF6;
        --rust: #A23B2E;
        --rust-tint: #F7E9E6;
        --radius-sm: 8px;
        --radius-lg: 14px;
        --font-display: "Sora", "Inter", sans-serif;
        --font-body: "Inter", sans-serif;
        --font-mono: "JetBrains Mono", monospace;
        font-family: var(--font-body);
        color: var(--ink);
    }

    .utilisateurs-page .page-title {
        font-family: var(--font-display);
        font-weight: 700;
        color: var(--ink);
        letter-spacing: -0.02em;
    }

    .utilisateurs-page .page-subtitle {
        color: var(--ink-muted);
    }

    .utilisateurs-page .count-badge {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--denim);
        background: var(--denim-tint);
        padding: 4px 10px;
        border-radius: var(--radius-sm);
    }

    /* ===== View toggle ===== */
    .view-toggle {
        display: flex;
        gap: 2px;
        padding: 3px;
        background: var(--sand);
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
    }

    .view-toggle-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        border: none;
        background: transparent;
        border-radius: 6px;
        color: var(--ink-muted);
        cursor: pointer;
        transition: background 0.15s ease, color 0.15s ease;
    }

        .view-toggle-btn.active {
            background: var(--paper);
            color: var(--denim);
            box-shadow: 0 1px 2px rgba(0,0,0,0.06);
        }

        .view-toggle-btn:hover:not(.active) {
            color: var(--ink);
        }

    /* ===== Bouton primary ===== */
    .utilisateurs-page .btn {
        display: flex;
        align-items: center;
        gap: 8px;
        border: none;
        border-radius: var(--radius-sm);
        padding: 9px 18px;
        font-family: var(--font-body);
        font-weight: 600;
        font-size: 0.875rem;
        cursor: pointer;
        transition: background 0.15s ease;
    }

    .utilisateurs-page .btn--primary {
        background: var(--denim);
        color: #fff;
        box-shadow: 0 6px 16px -6px rgba(43,76,126,0.4);
    }

        .utilisateurs-page .btn--primary:hover {
            background: var(--denim-dark);
        }

    /* ===== Filtre panel ===== */
    .filter-panel {
        background: var(--paper);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        padding: 16px;
    }

    .filter-chip {
        font-family: var(--font-body);
        font-weight: 600;
        font-size: 0.8125rem;
        padding: 6px 14px;
        border-radius: 999px;
        border: 1px solid var(--border);
        background: var(--paper);
        color: var(--ink-muted);
        cursor: pointer;
        white-space: nowrap;
        transition: all 0.15s ease;
    }

        .filter-chip:hover {
            border-color: var(--denim);
            color: var(--ink);
        }

        .filter-chip.active {
            background: var(--chip-color, var(--denim));
            border-color: var(--chip-color, var(--denim));
            color: #fff;
        }

    /* ===== Skeleton ===== */
    .skeleton-card {
        background: var(--paper);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        overflow: hidden;
    }

    /* ===== Empty state ===== */
    .empty-state {
        background: var(--paper);
        border: 1px dashed var(--border);
        border-radius: var(--radius-lg);
        padding: 64px 24px;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .empty-icon {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: var(--sand);
        color: var(--ink-muted);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 12px;
    }

    .empty-title {
        font-family: var(--font-display);
        font-weight: 600;
        color: var(--ink);
    }

    .empty-subtitle {
        color: var(--ink-muted);
    }

    /* ===== Carte utilisateur ===== */
    .user-card {
        display: flex;
        flex-direction: column;
        height: 100%;
        background: var(--paper);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        overflow: hidden;
        transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
    }

        .user-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 24px -12px rgba(20,38,63,0.25);
            border-color: transparent;
        }

    .swatch-strip {
        height: 4px;
        width: 100%;
    }

    .user-avatar-zone {
        position: relative;
        width: 100%;
        height: 100px;
        background: var(--sand);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .user-avatar {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        color: #fff;
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 1.25rem;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 2px 8px rgba(0,0,0,0.15);
    }

    .badge-role {
        position: absolute;
        top: 10px;
        right: 10px;
        font-size: 0.6875rem;
        font-weight: 600;
        color: #fff;
        padding: 3px 9px;
        border-radius: var(--radius-sm);
    }

    .user-body {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 12px;
        padding: 16px;
    }

    .user-name {
        font-family: var(--font-display);
        font-weight: 600;
        color: var(--ink);
        font-size: 1rem;
        line-height: 1.3;
    }

    .user-id {
        margin-top: 2px;
    }

    .id-code {
        font-family: var(--font-mono);
        font-weight: 600;
        font-size: 0.75rem;
        color: var(--denim);
        background: var(--denim-tint);
        padding: 2px 7px;
        border-radius: 5px;
    }

    /* ===== Bloc contact ===== */
    .contact-block {
        display: flex;
        flex-direction: column;
        gap: 6px;
        background: var(--sand);
        border-radius: var(--radius-sm);
        padding: 10px 12px;
    }

    .contact-row {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .contact-icon {
        color: var(--ink-muted) !important;
        font-size: 1rem !important;
        flex-shrink: 0;
    }

    .contact-value {
        font-size: 0.8125rem;
        font-weight: 500;
        color: var(--ink);
        word-break: break-all;
    }

    /* ===== Pied de carte ===== */
    .user-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        padding-top: 12px;
        border-top: 1px solid var(--border);
    }

    .role-select-wrap {
        flex: 1;
    }

    .action-btn {
        color: var(--ink-muted) !important;
    }

        .action-btn:hover {
            color: var(--denim) !important;
            background: var(--denim-tint) !important;
        }

    .action-btn--danger:hover {
        color: var(--rust) !important;
        background: var(--rust-tint) !important;
    }

    /* ===== Vue tableau ===== */
    .table-panel {
        background: var(--paper);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        overflow: hidden;
    }

    .users-table .mud-table-head th {
        font-family: var(--font-body);
        font-weight: 700;
        color: var(--ink-muted);
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        background: var(--sand);
    }

    .cell-name {
        font-family: var(--font-display);
        font-weight: 600;
        color: var(--ink);
    }

    .ref-code {
        font-family: var(--font-mono);
        font-weight: 600;
        font-size: 0.8125rem;
        color: var(--denim);
        background: var(--denim-tint);
        padding: 3px 8px;
        border-radius: 6px;
    }

    .table-role-tag {
        font-size: 0.75rem;
        font-weight: 600;
        color: #fff;
        padding: 3px 9px;
        border-radius: 6px;
    }

    .table-avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        color: #fff;
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 0.875rem;
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>

@code {
    private List<UtilisateurDto>? utilisateurs;
    private string searchString = "";
    private string roleFilter = "";
    private bool isGridView = true;

    // Palette cohérente avec la page produits
    private static readonly Dictionary<string, string> RoleColors = new()
    {
        { "ADMIN",                        "#2B4C7E" }, // denim
        { "RESPONSABLE_STOCK_PRODUCTION", "#4A6FA5" }, // steel blue
        { "CLIENT",                       "#B5563A" }  // clay
    };

    protected override async Task OnInitializedAsync()
    {
        await ChargerUtilisateurs();
    }

    private async Task ChargerUtilisateurs()
    {
        try
        {
            utilisateurs = await UtilisateurService.ObtenirTous();
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login");
        }
        catch
        {
            utilisateurs = new List<UtilisateurDto>();
        }
    }

    private IEnumerable<UtilisateurDto> FilteredUtilisateurs => utilisateurs == null
        ? Enumerable.Empty<UtilisateurDto>()
        : utilisateurs.Where(u => FilterFunc(u));

    private bool FilterFunc(UtilisateurDto u)
    {
        if (!string.IsNullOrEmpty(roleFilter) && !string.Equals(u.Role, roleFilter, StringComparison.OrdinalIgnoreCase))
            return false;

        if (string.IsNullOrWhiteSpace(searchString))
            return true;

        if (u.Nom?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        if (u.Prenom?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        if (u.Email?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        if (u.Role?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;

        return false;
    }

    private string GetInitials(string prenom, string nom)
    {
        var p = string.IsNullOrWhiteSpace(prenom) ? "" : prenom.Trim()[0].ToString().ToUpper();
        var n = string.IsNullOrWhiteSpace(nom)    ? "" : nom.Trim()[0].ToString().ToUpper();
        return $"{p}{n}";
    }

    private string GetRoleColor(string role) =>
        RoleColors.TryGetValue(role ?? "", out var color) ? color : "#64748B";

    private string GetRoleLabel(string role) => role switch
    {
        "ADMIN"                        => "Admin",
        "RESPONSABLE_STOCK_PRODUCTION" => "Resp. Stock & Production",
        "CLIENT"                       => "Client",
        _                              => role
    };

    private async Task ModifierRoleUser(UtilisateurDto user, string nouveauRole)
    {
        if (user.Role == nouveauRole) return;

        var succes = await UtilisateurService.ModifierRole(user.Id, nouveauRole);
        if (succes)
        {
            user.Role = nouveauRole;
            Snackbar.Add($"Rôle de {user.Prenom} mis à jour en {GetRoleLabel(nouveauRole)}.", Severity.Success);
        }
        else
        {
            Snackbar.Add("Erreur lors de la modification du rôle.", Severity.Error);
        }
    }

    private async Task SupprimerUser(int id)
    {
        var succes = await UtilisateurService.Supprimer(id);
        if (succes)
        {
            Snackbar.Add("Utilisateur supprimé avec succès.", Severity.Success);
            await ChargerUtilisateurs();
        }
        else
        {
            Snackbar.Add("Erreur lors de la suppression de l'utilisateur.", Severity.Error);
        }
    }

    private void AllerVersInscription() => Navigation.NavigateTo("/register");
}
